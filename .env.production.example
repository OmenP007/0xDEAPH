# ==============================================================================
# 0xSeq • Configuration d'Environnement de Production
# Dupliquer ce fichier vers .env avant de lancer en production
# ==============================================================================

# ── Sécurité Django ──
DEBUG=False
SECRET_KEY=cle_secrete_django_production_tres_longue_et_aleatoire_a_generer
ALLOWED_HOSTS=api.votredomaine.com,votredomaine.com,127.0.0.1

# ── Base de Données (sqlite3 par défaut, basculable sur postgresql) ──
DB_ENGINE=sqlite3

# Variables si bascule sur PostgreSQL 16:
# DB_ENGINE=postgresql
# POSTGRES_DB=0xseq_prod
# POSTGRES_USER=0xseq_user
# POSTGRES_PASSWORD=mot_de_passe_robuste_postgresql
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ── Courtier Celery & Cache Redis ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── GeniusPay (Passage en Production / Live) ──
GENIUS_PAY_SANDBOX=False
GENIUS_PAY_URL=https://geniuspay.ci/api/v1/merchant
GENIUS_PAY_API=pk_live_votre_cle_publique_production
GENIUS_PAY_SECRET=sk_live_votre_cle_secrete_production
GENIUS_PAY_WEBHOOK_SECRET=whsec_votre_secret_webhook_fourni_par_geniuspay

# ── Monitoring & Alertes Sentry (Optionnel mais fortement recommandé) ──
SENTRY_DSN=https://xxxxxxxx@o000000.ingest.sentry.io/0000000
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=production
