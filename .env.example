# ─── Django ───────────────────────────────────────────────────────────────────
# Génère une clé avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Base de données ──────────────────────────────────────────────────────────
# "sqlite3" pour SQLite (par défaut).
# "postgresql" pour PostgreSQL (production optionnelle).
DB_ENGINE=sqlite3

# PostgreSQL uniquement :
POSTGRES_DB=0xseq
POSTGRES_USER=0xseq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── GeniusPay ────────────────────────────────────────────────────────────────
# Mettre "True" pour utiliser le sandbox, "False" pour la production (Live).
GENIUS_PAY_SANDBOX=True

GENIUS_PAY_API_SANDBOX=pk_sandbox_VOTRE_CLE
GENIUS_PAY_SECRET_SANDBOX=sk_sandbox_VOTRE_SECRET

GENIUS_PAY_API=pk_live_VOTRE_CLE
GENIUS_PAY_SECRET=sk_live_VOTRE_SECRET

GENIUS_PAY_URL=https://geniuspay.ci/api/v1/merchant

# Secret partagé pour vérifier la signature des webhooks GeniusPay.
# Trouvable dans le tableau de bord GeniusPay → Webhooks → Détails.
GENIUS_PAY_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK

# ─── Celery & Redis ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Observabilité & Sécurité (Optionnels) ────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxx@o000000.ingest.sentry.io/0000000
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT=development
# WEBHOOK_MAX_AGE_SECONDS=300
